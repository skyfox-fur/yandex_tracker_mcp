# Яндекс Трекер MCP — переменные окружения
# Скопируйте этот файл в .env (рядом с yandex_tracker_mcp.py) и заполните значения.
# В другом месте — укажите путь в переменной окружения TRACKER_ENV_FILE

# OAuth-токен для Яндекс Трекера (ОБЯЗАТЕЛЕН)
# Получить: https://oauth.yandex.ru/authorize?response_type=token&client_id=<ClientID>
TRACKER_TOKEN=your_oauth_token_here

# Тип аутентификации: "oauth" (по умолчанию) или "iam"
# Для Cloud организаций используйте "iam" (токен: yc iam create-token)
TRACKER_AUTH_TYPE=oauth

# ID организации Яндекс 360 (ОБЯЗАТЕЛЕН, если не используется TRACKER_CLOUD_ORG_ID)
# Найти в Трекер → Администрирование → Организации
# Укажите числовой ID организации
TRACKER_ORG_ID=123456

# ID организации Yandex Cloud (используйте вместо TRACKER_ORG_ID для Cloud)
# Укажите ID вашей Cloud организации
# TRACKER_CLOUD_ORG_ID=

# Режим только для чтения: 1/true/yes/on скрывают все пишущие инструменты
# По умолчанию: пусто (запись разрешена). Другие значения — ошибка при запуске
TRACKER_READ_ONLY=

# URL API Трекера (опционально, только https)
# По умолчанию: https://api.tracker.yandex.net/v3
# TRACKER_API_URL=https://api.tracker.yandex.net/v3
