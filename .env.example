# Yandex Tracker MCP configuration.
# Usually these are passed by the MCP client (e.g. `claude mcp add -e ...`).
# To use a file instead, copy this to .env and point TRACKER_ENV_FILE at it.

# Required: OAuth token with tracker:read (and tracker:write for write tools)
TRACKER_TOKEN=your_oauth_token_here

# Exactly one of these is required (Tracker -> Administration -> Organizations)
TRACKER_ORG_ID=123456          # Yandex 360 organization
# TRACKER_CLOUD_ORG_ID=        # Yandex Cloud organization

# Optional
# TRACKER_AUTH_TYPE=oauth      # oauth (default) or iam
# TRACKER_READ_ONLY=1          # 1/true/yes/on hides all write tools
# TRACKER_API_URL=https://api.tracker.yandex.net/v3
# TRACKER_DOWNLOAD_DIR=       # default: <temp>/yandex-tracker-mcp
# TRACKER_UPLOAD_DIRS=        # extra upload dirs, os.pathsep-separated
# TRACKER_MAX_FILE_MB=50
